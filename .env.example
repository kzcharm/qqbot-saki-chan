# Copy this file to .env for local use. Production uses a GitHub Actions secret.
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx+~websockets+~aiohttp
LOG_LEVEL=INFO
QQ_IS_SANDBOX=false

# Official QQ bot configuration (JSON array).
QQ_BOTS=[]
qq_bot_secret=
STEAM_API_KEY=
GOKZ_TOP_API_KEY=
UPTIME_KUMA_API_KEY=
SUPERUSERS=[]

