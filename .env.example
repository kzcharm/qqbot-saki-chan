# Copy this file to .env for local use. Production uses a GitHub Actions secret.
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx+~websockets+~aiohttp
LOG_LEVEL=INFO
QQ_IS_SANDBOX=false

# On startup, publish the bot's commands to the official QQ command panels
# for c2c and group conversations. No extra token or configuration is needed.

# Official QQ bot configuration (JSON array).
QQ_BOTS=[]
# Shared with gokz.top for KZTOP binding-code verification. Never share this
# value with regular users. Rotating it invalidates outstanding binding codes.
QQ_BOT_SECRET=
STEAM_API_KEY=
GOKZ_TOP_API_KEY=
UPTIME_KUMA_API_KEY=
# Optional `/pr` first-completion voice compliments. Keep all values secret.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
SUPERUSERS=[]
